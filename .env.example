# ============ 模型配置 ============
# 主模型（写作/研究/分析智能体共用）
MODEL_NAME=kimi-k2.7-code
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEMPERATURE=0.7
MAX_ITER=3
# 最大执行轮数（写→审→改 回环上限）
MAX_REVISION_ROUNDS=2

# ============ 审校智能体(主编)专用模型 ============
# 不填则自动回退使用上面的主模型配置
EDITOR_MODEL_NAME=deepseek-v4-flash-0731
EDITOR_DASHSCOPE_API_KEY=your-dashscope-api-key
EDITOR_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDITOR_TEMPERATURE=0.7

# ============ 搜索工具 ============
TAVILY_API_KEY=your-tavily-api-key

# ============ 数据库 (MySQL) ============
# 本地运行填 localhost；Docker 容器内填 mysql(服务名)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=crew_ai

# ============ Langfuse 可观测性 ============
# CrewAI 原生自动上报，配好 key + 开 tracing 即可
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
CREWAI_TRACING_ENABLED=true
LANGFUSE_DEBUG=False

# ============ CrewAI AMP 认证 ============
# https://app.crewai.com/ 登录后在账号设置生成 API Key
CREWAI_API_KEY=your-crewai-api-key

# ============ 安全 ============
# 生产环境务必修改为随机强密钥
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# ============ MCP 服务 (Java Spring AI MCP, StreamableHTTP) ============
# MCP 部署在 Windows 本机时，backend 容器内 localhost 不可达，用 Windows 局域网 IP 直连
MCP_BASE_URL=http://10.26.10.213:8080/mcp/message
MCP_AUTH_TOKEN=your-mcp-auth-token
# 发布之前是否需要人工审核
REQUIRE_HUMAN_REVIEW=True

# ============ 默认账号（启动时自动建表并插入，若不存在）============
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=your-default-password
